// Zellij config

session_name "tranquility"
theme "starfield-light"

// Enable mouse
mouse_mode true

// Large scrollback buffer (tmux: history-limit 100000)
scroll_buffer_size 100000

// Copy to system clipboard via xsel (tmux: copy-pipe ... "xsel --clipboard")
copy_command "xsel --clipboard"
copy_on_select true

default_layout "compact"

keybinds clear-defaults=false {

    locked {
        // Keep this clear...
    }

    normal {
        // Mods to mode navigation
        bind "Ctrl ;"     { SwitchToMode "Pane"; }

        // Unbound Zellij modes can still be navigated to in TMUX mode
        unbind "Ctrl p" // Pane:   conflicts shell->prev cmd
        unbind "Ctrl o" // Session:conflicts nvim->prev cursor pos
        unbind "Ctrl n" // Resize: conflicts shell->next cmd
        unbind "Ctrl h" // Move:   conflicts nvim->harpoon
        
    }

    scroll {
        bind "q" { ScrollToBottom; SwitchToMode "Normal"; }
    }

    tmux {
        // Mode navigations
        bind "Ctrl Space" { SwitchToMode "Normal"; }

        // Unbinds ----------------------
        unbind "Space" // NextSwapLayout
        unbind "j"     // focus down
        unbind "k"     // focus up

        // Mods -------------------------
        // Rebind the pane splits
        unbind "%" // newpane right
        unbind "/" // newpane down
        bind "v"       { NewPane "Right"; SwitchToMode "Normal"; }
        bind "h"       { NewPane "Down";  SwitchToMode "Normal"; }
        // NewTab opens with cwd=$HOME
        bind "c"       { NewTab { cwd "/home/samkel"; }; SwitchToMode "Normal"; }

        // Augments ---------------------
        bind "f"       { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "l"       {
            Run "/home/samkel/.config/zellij/scripts/juggle-dlog.sh" {
                close_on_exit true
                floating true
                width "1"
                height "1"
                x "100%"
                y "100%"
            }; SwitchToMode "Normal";
        }

        // Plugins - Zextract
        bind "x" {
            LaunchOrFocusPlugin "file:///home/samkel/.config/zellij/plugins/zextract.wasm" {
                floating true;
            };
        }
    }

    scroll {
        // vi-style copy (tmux copy-mode-vi: v = begin-selection, y = copy-pipe-and-cancel)
        bind "v" { Copy; }
        bind "y" { Copy; SwitchToMode "Normal"; }
    }

    // Override use of MoveFocusOrTab
    shared_except "locked" {
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt l" { MoveFocus "Right"; }
    }

    shared_except "tmux" "locked" {
        unbind "Ctrl b"
        bind "Ctrl Space" { SwitchToMode "Tmux"; }
    }
}
