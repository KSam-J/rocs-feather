# Name: Starfield
# Variant: Light
# Description: A light theme built on the Starfield palette.

# --- Starfield Palette ---
sf_red="#c72138"
sf_orange="#e06236"
sf_yellow="#d7a64b"
sf_blue="#304c7a"
sf_purple="#6522a5"

# --- Neutral Base ---
sf_light="#ececec"   # primary background; also fg on accent backgrounds
sf_dark="#1a1a1a"    # primary text
sf_mid="#757575"     # secondary / dimmed text, inactive borders

# --- Semantic Roles ---
color_bg=$sf_light
color_fg=$sf_dark
color_fg_dim=$sf_mid
color_fg_on_accent=$sf_light

# Accent cycle (window_index mod 4): 0=red, 1=orange, 2=yellow, 3=blue
color_accent_0=$sf_red
color_accent_1=$sf_orange
color_accent_2=$sf_yellow
color_accent_3=$sf_blue

# ── Modes ─────────────────────────────────────────────────────────────────────
setw -g mode-style "fg=$sf_dark,bg=$sf_yellow,bold"

# ── Panes ─────────────────────────────────────────────────────────────────────
set -g pane-border-style       "fg=$sf_mid,bg=$sf_light"
set -g pane-active-border-style "fg=$sf_blue,bg=$sf_light"
set -g window-style            "bg=$sf_light"

# ── Status Bar ────────────────────────────────────────────────────────────────
set -g status-position     bottom
set -g status-justify      left
set -g status-style        "bg=$color_fg_dim,fg=$color_fg"
set -g status-left-length  20
set -g status-right-length 90

set -g status-left "#[fg=$sf_light][#S]"

set -g  status-right "#[fg=$color_fg_on_accent,bg=$sf_red] #(uv --directory /home/samkel/Automation/daylog run /home/samkel/Automation/daylog/daysum.py -x --filled '$sf_red' --empty '$sf_light')#[fg=$color_fg_on_accent,bg=$sf_red] "
set -ga status-right "#[fg=$color_fg_on_accent,bg=$sf_orange] #(ping -c 1 inside >/dev/null && echo BENCHNET || ip addr show | awk '/inet.*brd/{print \$NF; exit}') "
set -ga status-right "#[fg=$color_fg_on_accent,bg=$sf_yellow] %m/%d/%y "
set -ga status-right "#[fg=$color_fg_on_accent,bg=$sf_blue] %H:%M:%S "

# ── Window Status (inactive) ──────────────────────────────────────────────────
setw -g window-status-format      " #I#[fg=$sf_mid]:#[fg=$sf_dark]#W#[fg=$sf_mid]#F "
setw -g window-status-bell-style  "fg=$sf_light,bg=$sf_red,bold"

# ── Window Status (active) ────────────────────────────────────────────────────
# Background cycles through accent colors: window_index mod 4
setw -g window-status-current-format " #[fg=$color_fg_on_accent,bold,bg=#{?#{==:#{e|%|:#{window_index},4},0},$sf_red,#{?#{==:#{e|%|:#{window_index},4},1},$sf_orange,#{?#{==:#{e|%|:#{window_index},4},2},$sf_yellow,$sf_blue}}}]#I:#W#F "

# ── Messages ──────────────────────────────────────────────────────────────────
set -g message-style "fg=$sf_dark,bg=$sf_yellow,bold"
